# Downloaded by the installer (about 12 GB) - not stored in git
moss-image-pc/models/
moss-image-pc/bin/

# Python environment for the app (rebuild with tools/requirements.txt)
moss-image-pc/tools/venv/
__pycache__/
*.pyc

# Build output (the .exe is published on the Releases page instead)
dist/
packaging/build/
packaging/.venv-build/

# Your pictures and per-PC settings
moss-image-pc/outputs/
moss-image-pc/tools/gui_settings.json
moss-image-pc/tools/phone_sessions.json

# Logs, backups and temporary files
moss-image-install-log.txt
*.log
*.before-*
*.tmp
*.engine.png

# Engine backups and update staging
moss-image-pc/bin-old-*/
moss-image-pc/engine-update/

# Describer engine (llama.cpp) and engine update leftovers
moss-image-pc/llm-bin/
moss-image-pc/*-previous/
moss-image-pc/*-update/
moss-image-pc/*-new/
moss-image-pc/*-removed/
moss-image-pc/*.exe
